# ─────────────────────────────────────────────────────────────
# Cache control para landing pages IBERO
# ─────────────────────────────────────────────────────────────
# Problema previo: el servidor enviaba Cache-Control: max-age=2592000
# (30 días) para todos los archivos, incluyendo HTML. Eso obligaba a
# los usuarios a hacer Ctrl+R para ver cambios después de un deploy.
# ─────────────────────────────────────────────────────────────

<IfModule mod_headers.c>

    # HTML: nunca cachear. Siempre revalidar con el servidor.
    # El ETag/Last-Modified hace que la descarga real solo ocurra si cambió.
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Assets estáticos (imágenes, fuentes, PDFs): cachear 1 día.
    # Suficientemente corto para evitar problemas, suficientemente largo
    # para tener buen performance.
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|eot|pdf|mp4|webm)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # CSS y JS (cuando existan como archivos separados): 1 hora.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

</IfModule>
